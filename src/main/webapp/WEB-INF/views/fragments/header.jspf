<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<fmt:setLocale value="id_ID" />
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle != null ? pageTitle : 'Z-Store | Toko Lisensi Digital'}" /></title>
  <link rel="icon" href="${pageContext.request.contextPath}/static/Image/Logo/Logo.png">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.bunny.net/css?family=inter:400,500,600,700,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/zstore.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg sticky-top nav-glass">
    <div class="container">

      <!-- Brand logo -->
      <a class="navbar-brand d-flex align-items-center" href="${pageContext.request.contextPath}/home">
        <img src="${pageContext.request.contextPath}/static/Image/Logo/Logo.png" alt="Z-Store"
             style="height:34px; width:auto; object-fit:contain;">
      </a>

      <!-- Mobile toggler -->
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon" style="filter:invert(0.7)"></span>
      </button>

      <div id="mainNav" class="collapse navbar-collapse">

        <!-- Search bar — expanded, center -->
        <form class="d-flex flex-grow-1 my-2 my-lg-0 ms-lg-3 me-lg-3"
              action="${pageContext.request.contextPath}/home" method="GET" role="search">
          <c:if test="${activeProviderId != null && activeProviderId > 0}">
            <input type="hidden" name="provider" value="${activeProviderId}">
          </c:if>
          <c:if test="${not empty activeTagsParam}">
            <input type="hidden" name="tags" value="<c:out value='${activeTagsParam}'/>">
          </c:if>
          <div class="nav-search-wrap">
            <svg class="nav-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                 stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5"/>
              <line x1="13.5" y1="13.5" x2="17" y2="17"/>
            </svg>
            <input class="form-control nav-search" type="search" name="q"
                   value="<c:out value='${searchQuery}'/>"
                   placeholder="Cari produk, kategori, atau berdasarkan tags"
                   aria-label="Cari produk">
          </div>
        </form>

        <!-- Right-side nav items -->
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">

          <li class="nav-item">
            <a class="nav-link px-3" href="${pageContext.request.contextPath}/invoice">Cek Invoice</a>
          </li>

          <c:choose>
            <c:when test="${sessionScope.user != null}">

              <!-- Custom profile dropdown trigger -->
              <li class="nav-item ms-lg-1" style="position:relative;">
                <button type="button" class="nav-profile-trigger" id="profileTrigger"
                        aria-expanded="false" aria-haspopup="true">
                  <!-- Avatar circle -->
                  <span class="nav-avatar">
                    <c:choose>
                      <c:when test="${sessionScope.user.hasAvatar}">
                        <img src="<c:out value='${sessionScope.user.avatarSrc(pageContext.request.contextPath)}'/>"
                             alt="<c:out value='${sessionScope.user.namaPelanggan}'/>"
                             class="nav-avatar-img">
                      </c:when>
                      <c:otherwise>
                        <c:out value="${sessionScope.user.initial}" />
                      </c:otherwise>
                    </c:choose>
                  </span>
                  <!-- Name -->
                  <span class="nav-profile-name">
                    <c:out value="${sessionScope.user.namaPelanggan}" />
                  </span>
                  <!-- Caret -->
                  <svg class="nav-caret" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="4 6 8 10 12 6"/>
                  </svg>
                </button>

                <!-- Custom dropdown panel -->
                <div class="nav-dropdown-panel" id="profilePanel" role="menu">

                  <!-- Account info block -->
                  <div class="nav-dd-info">
                    <div class="nav-dd-info-top">
                      <span class="nav-dd-username">
                        <c:out value="${sessionScope.user.namaPelanggan}" />
                      </span>
                      <span class="nav-dd-level-badge">
                        <c:out value="${sessionScope.user.namaLevel}" />
                      </span>
                    </div>
                    <c:choose>
                      <c:when test="${sessionScope.user.admin}">
                        <div class="nav-dd-info-sub">
                          <span class="nav-dd-label">Role</span>
                          <span class="nav-dd-value">Administrator</span>
                        </div>
                      </c:when>
                      <c:otherwise>
                        <div class="nav-dd-info-sub">
                          <span class="nav-dd-label">Diskon Level</span>
                          <span class="nav-dd-value num-tabular">
                            <c:out value="${sessionScope.user.diskonLevel}" />%
                          </span>
                        </div>
                      </c:otherwise>
                    </c:choose>
                  </div>

                  <div class="nav-dd-divider"></div>

                  <!-- Dashboard link -->
                  <a class="nav-dd-item" href="${pageContext.request.contextPath}/dashboard" role="menuitem">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="2" width="7" height="7" rx="1.5"/>
                      <rect x="11" y="2" width="7" height="7" rx="1.5"/>
                      <rect x="2" y="11" width="7" height="7" rx="1.5"/>
                      <rect x="11" y="11" width="7" height="7" rx="1.5"/>
                    </svg>
                    Dashboard
                  </a>

                  <!-- Admin link (only for admin role) -->
                  <c:if test="${sessionScope.user.admin}">
                    <a class="nav-dd-item" href="${pageContext.request.contextPath}/admin" role="menuitem">
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75"
                           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="10" cy="10" r="3"/>
                        <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.22 4.22l1.42 1.42M14.36 14.36l1.42 1.42M4.22 15.78l1.42-1.42M14.36 5.64l1.42-1.42"/>
                      </svg>
                      Admin Panel
                    </a>
                  </c:if>

                  <div class="nav-dd-divider"></div>

                  <!-- Logout -->
                  <form method="POST" action="${pageContext.request.contextPath}/logout" style="margin:0;">
                    <button type="submit" class="nav-dd-item nav-dd-item--danger" role="menuitem">
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75"
                           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13 15l3-5-3-5"/>
                        <path d="M16 10H7"/>
                        <path d="M7 19H3a1 1 0 01-1-1V2a1 1 0 011-1h4"/>
                      </svg>
                      Logout
                    </button>
                  </form>

                </div><!-- /nav-dropdown-panel -->
              </li>

            </c:when>
            <c:otherwise>
              <li class="nav-item ms-lg-2">
                <a class="btn btn-sm btn-ghost" href="${pageContext.request.contextPath}/register">Daftar</a>
              </li>
              <li class="nav-item ms-lg-1">
                <a class="btn btn-sm btn-dash-primary px-3" href="${pageContext.request.contextPath}/login">Login</a>
              </li>
            </c:otherwise>
          </c:choose>
        </ul>
      </div><!-- /mainNav -->
    </div><!-- /container -->
  </nav>

  <script>
  (function () {
    var trigger = document.getElementById('profileTrigger');
    var panel   = document.getElementById('profilePanel');
    if (!trigger || !panel) return;

    function open() {
      panel.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('is-open');
    }
    function close() {
      panel.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('is-open');
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      panel.classList.contains('is-open') ? close() : open();
    });

    document.addEventListener('click', function (e) {
      if (!panel.contains(e.target) && e.target !== trigger) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  }());
  </script>

  <main>
