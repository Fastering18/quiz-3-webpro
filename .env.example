# Database Configuration (TiDB Cloud Serverless / MySQL)
# Replace <PASSWORD> with your TiDB Cloud password.
# After importing sql/schema.sql and sql/seed.sql, use database zstore_jsp (not /sys).
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=zstore_jsp
DB_USER=2YwCNykgsBcN7yV.root
DB_PASSWORD=<PASSWORD>
DB_SSL=true

# Alternative single-URI format (also supported):
# DB_URL=mysql://2YwCNykgsBcN7yV.root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/zstore_jsp

# Sumopod Managed Payment (QRIS)
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_TOKEN=
PAYMENT_DEBUG_MODE=true
PAYMENT_EXPIRE_MINUTES=60

